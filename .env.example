# =============================================================================
# Django Configuration
# =============================================================================

# Secret key for cryptographic signing
# Generate a new one: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=django-insecure-change-this-in-production-abc123xyz456

# Debug mode (True for development, False for production)
DEBUG=True

# Allowed hosts (comma-separated for production)
# Example: ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com
ALLOWED_HOSTS=localhost,127.0.0.1

# =============================================================================
# PostgreSQL Database Configuration
# =============================================================================

# Database name
POSTGRES_DB=hop_barley_db

# Database user
POSTGRES_USER=postgres

# Database password
POSTGRES_PASSWORD=your_secure_password_here

# Database host (use 'db' for Docker, 'localhost' for local development)
POSTGRES_HOST=localhost

# Database port
POSTGRES_PORT=5432

# =============================================================================
# Email Configuration
# =============================================================================

# Email backend (console for development, smtp for production)
# Options:
#   - django.core.mail.backends.console.EmailBackend (prints to console)
#   - django.core.mail.backends.smtp.EmailBackend (real SMTP server)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# Default "from" email address
DEFAULT_FROM_EMAIL=no_replace@hopandbarley.com

# Admin email for notifications
ADMIN_EMAIL=admin@hopandbarley.com

# SMTP settings (only if using real email)
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your-email@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password

# =============================================================================
# Session Configuration
# =============================================================================

# Session key for shopping cart
CART_SESSION_KEY=cart

# =============================================================================
# Product Configuration
# =============================================================================

# Allowed sorting options for products (comma-separated)
# Options: -created_at, price, -price, rating, -rating, name, -name
PRODUCT_ALLOWED_SORTING=-created_at,price,-price,-rating

# =============================================================================
# JWT Configuration (Simple JWT)
# =============================================================================

# Access token lifetime (in minutes)
SIMPLE_JWT_ACCESS_TOKEN_LIFETIME=60

# Refresh token lifetime (in minutes)
SIMPLE_JWT_REFRESH_TOKEN_LIFETIME=1440

# =============================================================================
# Static and Media Files
# =============================================================================

# Static files URL
STATIC_URL=/static/

# Media files URL
MEDIA_URL=/media/

# =============================================================================
# Security Settings (Production Only)
# =============================================================================

# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# SECURE_HSTS_PRELOAD=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# SECURE_BROWSER_XSS_FILTER=True
# SECURE_CONTENT_TYPE_NOSNIFF=True
# X_FRAME_OPTIONS=DENY

# =============================================================================
# Logging Configuration
# =============================================================================

# LOG_LEVEL=INFO
# LOG_FILE=logs/django.log